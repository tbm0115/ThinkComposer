{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tbm0115/ThinkComposer/docs/thinkcomposer-container-manifest.schema.json",
  "title": "ThinkComposer Container Snapshot Manifest",
  "description": "Schema for non-authoritative /Interchange/manifest.json sidecars. Version 2 adds verified preview reuse metadata; native Open/Save never reads this manifest as model state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "generatedAtUtc",
    "application",
    "packageKind",
    "nativePartUri",
    "jsonParts",
    "previews",
    "warnings"
  ],
  "properties": {
    "format": {
      "const": "ThinkComposer.ContainerSnapshot"
    },
    "formatVersion": {
      "const": 2,
      "description": "Version 2 preview entries carry deterministic render-input hashes and renderer profiles. Version 1 caches are ignored and regenerated by current saves."
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "application": {
      "const": "ThinkComposer"
    },
    "applicationVersion": {
      "type": [
        "string",
        "null"
      ]
    },
    "packageKind": {
      "enum": [
        "composition",
        "domain"
      ]
    },
    "nativePartUri": {
      "enum": [
        "/Composition.json",
        "/Domain.json"
      ],
      "description": "Authoritative root JSON part represented by this optional sidecar."
    },
    "nativePartSha256": {
      "$ref": "#/$defs/sha256OrNull",
      "description": "SHA-256 of the authoritative root JSON bytes, never a legacy binary part hash."
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "jsonParts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/jsonPart"
      }
    },
    "previews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/preview"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sha256OrNull": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "techName": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "versionNumber": {
          "type": [
            "string",
            "null"
          ]
        },
        "versionSequence": {
          "type": [
            "integer",
            "null"
          ]
        },
        "lastModification": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "jsonPart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "partUri",
        "sha256",
        "bytes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "composition",
            "embeddedDomain",
            "domain",
            "templateComposition"
          ]
        },
        "partUri": {
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256OrNull"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "capped",
        "skipped",
        "inputSha256",
        "renderProfile"
      ],
      "properties": {
        "viewId": {
          "type": [
            "string",
            "null"
          ]
        },
        "viewName": {
          "type": [
            "string",
            "null"
          ]
        },
        "viewTechName": {
          "type": [
            "string",
            "null"
          ]
        },
        "partUri": {
          "type": [
            "string",
            "null"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        },
        "capped": {
          "type": "boolean"
        },
        "skipped": {
          "type": "boolean"
        },
        "inputSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Deterministic hash of render-affecting view/model/domain input. It is not the PNG hash."
        },
        "renderProfile": {
          "type": "string",
          "minLength": 1,
          "description": "Renderer version and output dimensions used to decide whether a verified cached PNG is reusable."
        },
        "disposition": {
          "enum": [
            "rendered",
            "reused",
            "empty"
          ],
          "description": "Whether PNG bytes were rendered now, copied from a verified prior package, or omitted because the view has no renderable content."
        },
        "warning": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256OrNull",
          "description": "SHA-256 of the actual PNG bytes for rendered/reused entries."
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "rendered",
                  "reused"
                ]
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "required": [
              "partUri",
              "sha256",
              "bytes"
            ],
            "properties": {
              "partUri": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "skipped": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "empty"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "skipped": {
                "const": true
              },
              "partUri": {
                "type": "null"
              },
              "sha256": {
                "type": "null"
              },
              "bytes": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
