                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="86" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><TextBlock Text="Name/Title" Foreground="#111827" VerticalAlignment="Center" /><TextBox x:Name="ComplementNameTextBox" Grid.Column="1" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" BorderBrush="#9EB5C2" TextChanged="ComplementEditorFieldChanged" /><TextBlock Grid.Column="2" Text="Pictogram" Foreground="#111827" VerticalAlignment="Center" /><TextBox x:Name="ComplementPictogramTextBox" Grid.Column="3" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" BorderBrush="#9EB5C2" TextChanged="ComplementEditorFieldChanged" /></Grid>
                <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="92" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions><TextBlock Text="Tech-Name" Foreground="#111827" VerticalAlignment="Center" /><TextBox x:Name="ComplementTechNameTextBox" Grid.Column="1" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" BorderBrush="#9EB5C2" /><TextBlock Grid.Column="2" Text="Kind" Foreground="#111827" VerticalAlignment="Center" /><ComboBox x:Name="ComplementKindComboBox" Grid.Column="3" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" SelectionChanged="ComplementEditorSelectionChanged" /></Grid>
                <TextBox x:Name="ComplementSummaryTextBox" Height="96" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" BorderBrush="#9EB5C2" PlaceholderText="Summary" AcceptsReturn="True" TextWrapping="Wrap" />
                <TextBox x:Name="ComplementGlobalIdTextBox" RequestedTheme="Light" Foreground="#475569" Background="#F8FAFC" BorderBrush="#CBD5E1" IsReadOnly="True" />
              </StackPanel>
              <StackPanel x:Name="ComplementVisualPanel" Visibility="Collapsed" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Foreground" Foreground="#111827" VerticalAlignment="Center" /><TextBox x:Name="ComplementForegroundTextBox" Width="112" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" BorderBrush="#9EB5C2" TextChanged="ComplementEditorFieldChanged" /><TextBlock Text="Background" Foreground="#111827" VerticalAlignment="Center" /><TextBox x:Name="ComplementBackgroundTextBox" Width="112" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" BorderBrush="#9EB5C2" TextChanged="ComplementEditorFieldChanged" /><TextBlock Text="Line Dash" Foreground="#111827" VerticalAlignment="Center" /><ComboBox x:Name="ComplementDashComboBox" Width="130" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" /></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Line Thickness" Foreground="#111827" VerticalAlignment="Center" /><TextBox x:Name="ComplementThicknessTextBox" Width="82" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" BorderBrush="#9EB5C2" TextChanged="ComplementEditorFieldChanged" /><TextBlock Text="Orientation" Foreground="#111827" VerticalAlignment="Center" /><ComboBox x:Name="ComplementOrientationComboBox" Width="140" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" /><TextBlock Text="Quadrant" Foreground="#111827" VerticalAlignment="Center" /><ComboBox x:Name="ComplementQuadrantComboBox" Width="140" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" /></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="Offset X" Foreground="#111827" VerticalAlignment="Center" /><TextBox x:Name="ComplementOffsetXTextBox" Width="82" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" BorderBrush="#9EB5C2" /><TextBlock Text="Offset Y" Foreground="#111827" VerticalAlignment="Center" /><TextBox x:Name="ComplementOffsetYTextBox" Width="82" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" BorderBrush="#9EB5C2" /><TextBlock Text="Initial Width" Foreground="#111827" VerticalAlignment="Center" /><TextBox x:Name="ComplementWidthTextBox" Width="82" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" BorderBrush="#9EB5C2" /><TextBlock Text="Initial Height" Foreground="#111827" VerticalAlignment="Center" /><TextBox x:Name="ComplementHeightTextBox" Width="82" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" BorderBrush="#9EB5C2" /></StackPanel>
              </StackPanel>
              <StackPanel x:Name="ComplementContentPanel" Visibility="Collapsed" Spacing="8"><TextBlock Text="Text / note / stamp defaults" Foreground="#111827" FontWeight="SemiBold" /><TextBox x:Name="ComplementTextTextBox" Height="160" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" BorderBrush="#9EB5C2" AcceptsReturn="True" TextWrapping="Wrap" /><TextBlock Text="Image asset default" Foreground="#111827" FontWeight="SemiBold" /><TextBox x:Name="ComplementImageAssetTextBox" RequestedTheme="Light" Foreground="#111827" Background="#FFFFFF" BorderBrush="#9EB5C2" /></StackPanel>
            </Grid>
          </ScrollViewer>
          <Grid Grid.Row="4" Background="#CCF8FFFF" Padding="8" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="ComplementEditorValidationText" Foreground="#B91C1C" VerticalAlignment="Center" TextWrapping="Wrap" /><Button Grid.Column="1" Style="{StaticResource CommandButtonStyle}" Click="ComplementEditorOkClicked"><StackPanel Orientation="Horizontal" Spacing="5"><SymbolIcon Symbol="Accept" Foreground="#16A34A" /><TextBlock Text="OK" Foreground="#111827" /></StackPanel></Button><Button Grid.Column="2" Style="{StaticResource CommandButtonStyle}" Click="ComplementEditorCancelClicked"><StackPanel Orientation="Horizontal" Spacing="5"><SymbolIcon Symbol="Cancel" Foreground="#DC2626" /><TextBlock Text="Cancel" Foreground="#111827" /></StackPanel></Button></Grid>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Page>
