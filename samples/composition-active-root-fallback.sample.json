      "x": 120,
      "y": 140,
      "width": 180,
      "height": 64,
      "set": {
        "name": "Active Root Source",
        "techName": "Active_Root_Fallback_Source",
        "summary": "First endpoint for the active-root container fallback regression sample.",
        "techSpec": "sample: composition-active-root-fallback\nrole: source"
      }
    },
    {
      "op": "create",
      "entity": "concept",
      "id": "97000000-0000-4000-8000-000000000002",
      "definitionTechName": "Concept",
      "containerTechName": "Active_Composition_Root",
      "x": 420,
      "y": 140,
      "width": 180,
      "height": 64,
      "set": {
        "name": "Active Root Target",
        "techName": "Active_Root_Fallback_Target",
        "summary": "Second endpoint for the active-root container fallback regression sample.",
        "techSpec": "sample: composition-active-root-fallback\nrole: target"
