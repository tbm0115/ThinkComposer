{
  "format": "ThinkComposer.JsonInterchange",
  "formatVersion": 1,
  "application": "ThinkComposer",
  "operations": [
    {
      "op": "update",
      "entity": "composition",
      "id": "replace-with-root-composition-id",
      "set": {
        "summary": "GPT-edited project summary."
      }
    },
    {
      "op": "update",
      "entity": "concept",
      "id": "replace-with-existing-concept-id",
      "set": {
        "name": "Renamed concept",
        "summary": "A concise GPT-assisted summary for this concept."
      }
    },
    {
      "op": "create",
      "entity": "concept",
      "definitionTechName": "Concept",
      "containerId": "replace-with-root-composition-id",
      "set": {
        "name": "New concept from GPT",
        "techName": "NewConceptFromGpt",
        "summary": "Created through JSON import. Replace the definition tech name if your domain uses a specialized concept definition."
      }
    },
    {
      "op": "create",
      "entity": "relationship",
      "definitionTechName": "Relationship",
      "containerId": "replace-with-root-composition-id",
      "originIdeaIds": [
        "replace-with-origin-concept-id"
      ],
      "targetIdeaIds": [
        "replace-with-target-concept-id"
      ],
      "set": {
        "name": "GPT suggested relationship",
        "techName": "GptSuggestedRelationship",
        "summary": "Connects two existing concepts by id."
      }
    }
  ]
}
