{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thinkcomposer.local/schemas/thinkcomposer-package-manifest-1.schema.json",
  "title": "ThinkComposer Native Package Manifest",
  "description": "Schema for root /manifest.json in JSON-authoritative .tcom and .tdom packages.",
  "type": "object",
  "required": [
    "format",
    "formatVersion",
    "application",
    "savedAtUtc",
    "packageKind",
    "persistenceFormat",
    "persistenceFormatVersion",
    "authoritativeParts",
    "legacyBinaryFallback",
    "sidecars",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "ThinkComposer.Package"
    },
    "formatVersion": {
      "const": 1
    },
    "application": {
      "const": "ThinkComposer"
    },
    "applicationVersion": {
      "type": "string"
    },
    "savedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "packageKind": {
      "type": "string",
      "enum": [
        "composition",
        "domain"
      ]
    },
    "persistenceFormat": {
      "const": "json"
    },
    "persistenceFormatVersion": {
      "const": 1
    },
    "authoritativeParts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/authoritativePart"
      }
    },
    "legacyBinaryFallback": {
      "$ref": "#/$defs/legacyBinaryFallback"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "gitSync": {
      "$ref": "#/$defs/gitSync"
    },
    "embeddedDomainGitSync": {
      "$ref": "#/$defs/gitSync",
      "description": "Optional .tcom-only Git linkage for the embedded Domain source. This is separate from package-level gitSync so a Composition and its base Domain can come from different remotes or paths."
    },
    "sidecars": {
      "$ref": "#/$defs/sidecars"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "$defs": {
    "partUri": {
      "type": "string",
      "pattern": "^/[^\\\\]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authoritativePart": {
      "type": "object",
      "required": [
        "kind",
        "partUri",
        "format",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "composition",
            "embeddedDomain",
            "domain",
            "templateComposition"
          ]
        },
        "partUri": {
          "$ref": "#/$defs/partUri"
        },
        "format": {
          "type": "string",
          "enum": [
            "ThinkComposer.JsonInterchange",
            "ThinkComposer.DomainJsonInterchange"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "legacyBinaryFallback": {
      "type": "object",
      "required": [
        "present"
      ],
      "additionalProperties": false,
      "properties": {
        "present": {
          "type": "boolean"
        },
        "partUri": {
          "$ref": "#/$defs/partUri"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "techName": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "versionNumber": {
          "type": "string"
        },
        "versionSequence": {
          "type": "integer"
        },
        "lastModification": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[^/\\\\]+(?:/[^/\\\\]+)*$"
    },
    "gitSync": {
      "type": "object",
      "required": [
        "version",
        "remote",
        "baselines"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "remote": {
          "$ref": "#/$defs/gitRemote"
        },
        "baselines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/gitBaseline"
          }
        }
      }
    },
    "gitRemote": {
      "type": "object",
      "required": [
        "url",
        "branch"
      ],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "description": "Generic Git remote URL. Credentials and tokens must not be embedded."
        },
        "branch": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "gitBaseline": {
      "type": "object",
      "required": [
        "kind",
        "role",
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "composition",
            "domain"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "self",
            "embeddedDomainSource"
          ]
        },
        "path": {
          "$ref": "#/$defs/repoPath"
        }
      }
    },
    "sidecars": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interchangeManifestUri": {
          "$ref": "#/$defs/partUri"
        }
      }
    }
  }
}
